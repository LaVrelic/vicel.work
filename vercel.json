{
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "style.css", "use": "@vercel/static" },
    { "src": "main.js", "use": "@vercel/static" },
    { "src": "logo.png", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/server\\.js", "dest": "/" },
    { "src": "/package\\.json", "dest": "/" },
    { "src": "/package-lock\\.json", "dest": "/" },
    { "src": "/\\.env\\.example", "dest": "/" },
    { "src": "/netlify\\.toml", "dest": "/" }
  ]
}
