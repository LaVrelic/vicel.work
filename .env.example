# ── vicel.work site server ──
# Скопируйте в .env и заполните значения. .env не попадает в git.

# Отправка писем (Resend -> https://resend.com/api-keys)
RESEND_API_KEY=
MAIL_FROM=Vicel Auth <auth@vicel.work>

# Порт сайта
PORT=3000

# Секрет для внутреннего API (генерация: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))")
INTERNAL_SECRET=

# Путь к SQLite-базе бота (fallback, если Supabase не задан)
BOT_DB_PATH=tgbot/data/vicel.db

# Postgres (Supabase) — основной источник ключей бота.
# Рекомендуется отдельная роль только с правом SELECT на таблицу keys:
#   CREATE ROLE vicel_site LOGIN PASSWORD '...';
#   GRANT USAGE ON SCHEMA public TO vicel_site;
#   GRANT SELECT ON public.keys TO vicel_site;
SUPABASE_DB_URL=
